{
  "name": "@rixl/ui",
  "version": "0.1.1",
  "description": "Rixl design system — reusable React components, tokens, and Tailwind preset shared across Rixl web projects.",
  "keywords": [
    "components",
    "design-system",
    "react",
    "rixl",
    "tailwind",
    "ui"
  ],
  "homepage": "https://github.com/rixlhq/rixl-ui",
  "bugs": {
    "url": "https://github.com/rixlhq/rixl-ui/issues"
  },
  "license": "MIT",
  "author": "Rixl Inc.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rixlhq/rixl-ui.git"
  },
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist",
    "src/styles",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./button": {
      "types": "./dist/button.d.ts",
      "development": "./src/components/button/index.ts",
      "import": "./dist/button.js"
    },
    "./label": {
      "types": "./dist/label.d.ts",
      "development": "./src/components/label/index.ts",
      "import": "./dist/label.js"
    },
    "./separator": {
      "types": "./dist/separator.d.ts",
      "development": "./src/components/separator/index.ts",
      "import": "./dist/separator.js"
    },
    "./badge": {
      "types": "./dist/badge.d.ts",
      "development": "./src/components/badge/index.ts",
      "import": "./dist/badge.js"
    },
    "./avatar": {
      "types": "./dist/avatar.d.ts",
      "development": "./src/components/avatar/index.ts",
      "import": "./dist/avatar.js"
    },
    "./skeleton": {
      "types": "./dist/skeleton.d.ts",
      "development": "./src/components/skeleton/index.ts",
      "import": "./dist/skeleton.js"
    },
    "./progress": {
      "types": "./dist/progress.d.ts",
      "development": "./src/components/progress/index.ts",
      "import": "./dist/progress.js"
    },
    "./alert": {
      "types": "./dist/alert.d.ts",
      "development": "./src/components/alert/index.ts",
      "import": "./dist/alert.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "development": "./src/components/input/index.ts",
      "import": "./dist/input.js"
    },
    "./textarea": {
      "types": "./dist/textarea.d.ts",
      "development": "./src/components/textarea/index.ts",
      "import": "./dist/textarea.js"
    },
    "./checkbox": {
      "types": "./dist/checkbox.d.ts",
      "development": "./src/components/checkbox/index.ts",
      "import": "./dist/checkbox.js"
    },
    "./radio-group": {
      "types": "./dist/radio-group.d.ts",
      "development": "./src/components/radio-group/index.ts",
      "import": "./dist/radio-group.js"
    },
    "./switch": {
      "types": "./dist/switch.d.ts",
      "development": "./src/components/switch/index.ts",
      "import": "./dist/switch.js"
    },
    "./select": {
      "types": "./dist/select.d.ts",
      "development": "./src/components/select/index.ts",
      "import": "./dist/select.js"
    },
    "./input-otp": {
      "types": "./dist/input-otp.d.ts",
      "development": "./src/components/input-otp/index.ts",
      "import": "./dist/input-otp.js"
    },
    "./tooltip": {
      "types": "./dist/tooltip.d.ts",
      "development": "./src/components/tooltip/index.ts",
      "import": "./dist/tooltip.js"
    },
    "./popover": {
      "types": "./dist/popover.d.ts",
      "development": "./src/components/popover/index.ts",
      "import": "./dist/popover.js"
    },
    "./dialog": {
      "types": "./dist/dialog.d.ts",
      "development": "./src/components/dialog/index.ts",
      "import": "./dist/dialog.js"
    },
    "./alert-dialog": {
      "types": "./dist/alert-dialog.d.ts",
      "development": "./src/components/alert-dialog/index.ts",
      "import": "./dist/alert-dialog.js"
    },
    "./sheet": {
      "types": "./dist/sheet.d.ts",
      "development": "./src/components/sheet/index.ts",
      "import": "./dist/sheet.js"
    },
    "./preset.css": "./src/styles/preset.css",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vp pack --watch",
    "build": "vp pack",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test",
    "test:run": "vp test --run",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "vp config --no-hooks"
  },
  "dependencies": {
    "@base-ui-components/react": "^1.0.0-rc.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "input-otp": "^1.4.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/coverage-v8": "4.1.10",
    "@vitest/ui": "4.1.10",
    "jsdom": "^30.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.0",
    "typescript": "6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "^0.2.4"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.3.14"
}
