{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    // The published entry points: every subpath in package.json "exports" maps to one of these.
    "src/components/*/index.ts",
    // .github/workflows/mutation.yml runs it; Knip doesn't read workflows outside this package.
    "scripts/*.mjs",
    // stryker.config.mjs names the Vitest config as a string.
    "test/stryker.vitest.config.ts",
  ],
  "ignoreDependencies": [
    // The OpenSpec skills run the CLI as `vp exec openspec`; nothing imports it.
    "@fission-ai/openspec",
  ],
}
