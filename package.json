{
  "name": "rixl-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @rixl/ui — the Rixl design system.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "vp run -F @rixl/ui build",
    "dev": "vp run -F @rixl/ui dev",
    "check": "vp run -F @rixl/ui check",
    "fmt": "vp run -F @rixl/ui fmt",
    "test": "vp run -F @rixl/ui test",
    "test:run": "vp run -F @rixl/ui test:run",
    "test:coverage": "vp run -F @rixl/ui test:coverage",
    "playground": "vp run -F @rixl/ui-playground dev",
    "playground:build": "vp run -F @rixl/ui build && vp run -F @rixl/ui-playground build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "1.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.2"
}
