{
  "name": "rixl-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @rixl/ui — the Rixl design system.",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vp run -F @rixl/ui build",
    "dev": "vp run -F @rixl/ui dev",
    "check": "vp run -F @rixl/ui check",
    "fmt": "vp run -F @rixl/ui fmt",
    "test": "vp run -F @rixl/ui test",
    "test:run": "vp run -F @rixl/ui test:run",
    "test:coverage": "vp run -F @rixl/ui test:coverage",
    "typecheck": "tsc --noEmit",
    "playground": "vp run -F playground dev",
    "playground:build": "vp run -F @rixl/ui build && vp run -F playground build",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vite-plus": "1.3.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.3.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "warn"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.4"
}
