{
  "name": "rixl-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @rixl/ui — the Rixl design system.",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --filter=@rixl/ui build",
    "dev": "bun run --filter=@rixl/ui dev",
    "check": "bun run --filter=@rixl/ui check",
    "fmt": "bun run --filter=@rixl/ui fmt",
    "test": "bun run --filter=@rixl/ui test",
    "test:run": "bun run --filter=@rixl/ui test:run",
    "test:coverage": "bun run --filter=@rixl/ui test:coverage",
    "playground": "bun run --filter=@rixl/ui-playground dev",
    "playground:build": "bun run --filter=@rixl/ui build && bun run --filter=@rixl/ui-playground build",
    "prepare": "lefthook install || true"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "lefthook": "^2.1.8",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "bun@1.4.0"
}
