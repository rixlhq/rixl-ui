{
  "name": "rixl-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @rixl/ui — the Rixl design system.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "vpr -F @rixl/ui build",
    "dev": "vpr -F @rixl/ui dev",
    "check": "vp check && vpr -F @rixl/ui react-doctor",
    "fmt": "vp fmt",
    "test": "vpr -F @rixl/ui test",
    "test:run": "vpr -F @rixl/ui test:run",
    "test:browser": "vpr -F @rixl/ui test:browser",
    "test:coverage": "vpr -F @rixl/ui test:coverage",
    "ci": "vpr ci:check && vpr ci:ui && vpr ci:docs",
    "ci:check": "vpr check",
    "ci:ui": "vpr -F @rixl/ui ci:package",
    "ci:docs": "vpr -F docs build",
    "typecheck": "tsc --noEmit",
    "docs": "vpr -F docs dev",
    "docs:build": "vpr -F @rixl/ui build && vpr -F docs build",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
