{
  "name": "rixl-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @rixl/ui — the Rixl design system.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vpr --parallel -F './packages/*' dev",
    "pack": "NODE_ENV=production vpr --parallel -F './packages/*' pack",
    "check": "vp check && vpr -F @rixl/ui react-doctor",
    "docs": "vpr -F docs dev",
    "docs:build": "vpr pack && NODE_ENV=production vpr -F docs build",
    "ci": "vpr ci:check && vpr ci:ui && vpr ci:docs",
    "ci:check": "vpr check",
    "ci:ui": "vpr -F @rixl/ui ci:package",
    "ci:docs": "vpr -F docs test && NODE_ENV=production vpr -F docs build",
    "clean": "vpr -F './packages/*' clean",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "test:coverage": "vpr -F @rixl/ui test:coverage",
    "test:mutation": "vpr -F @rixl/ui test:mutation"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vite-plus": "1.6.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.6.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
