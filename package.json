{
  "name": "rixl-ui-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Workspace root for @rixl/ui — the Rixl design system.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "vpr --parallel -F './packages/*' dev",
    "pack": "NODE_ENV=production vpr --parallel -F './packages/*' pack",
    "docs": "NODE_ENV=production vpr --parallel -F './apps/*' build",
    "clean": "vpr -F './packages/*' clean",
    "prepare": "[ -n \"$CI\" ] || lefthook install --reset-hooks-path",
    "test": "vp test",
    "test:prop": "vp test --project unit -t '\\[property\\]'",
    "test:types": "vp test --run --project types",
    "test:mutation": "stryker run",
    "test:ct": "vp test --project 'browser:*' --run",
    "test:ct:ui": "vp test watch --project 'browser:*' --ui",
    "test:coverage": "vp test --coverage"
  },
  "devDependencies": {
    "@fission-ai/openspec": "2.0.0",
    "lefthook": "^2.2.2",
    "typescript": "^7.0.2",
    "vite-plus": "1.8.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8001"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4",
      "onFail": "download"
    }
  }
}
